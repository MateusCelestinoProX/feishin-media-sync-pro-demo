<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dismiss_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/dismiss_circle"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_dismiss_target"
        android:gravity="center"
        android:orientation="vertical"
        android:elevation="12dp">

        <ImageView
            android:id="@+id/dismiss_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_delete"
            android:contentDescription="Desativar Ícone Flutuante" />

        <TextView
            android:id="@+id/dismiss_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Solte"
            android:textColor="#F43F5E"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

</FrameLayout>
